<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Configuration for IIS settings -->
  <system.webServer>

    <!-- URL Rewrite module to handle client-side routing (React Router) -->
    <rewrite>
      <rules>
        <rule name="React Router Fallback" stopProcessing="true">
          <!-- This rule ensures that non-static file URLs are routed to index.html -->
          <match url="^(?!.*\.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|ttf|woff|woff2|eot|otf|json|xml)$)" />
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Static file settings -->
    <!-- <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <mimeMap fileExtension=".ttf" mimeType="application/font-ttf" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent> -->

    <!-- Directory browsing (disable for production) -->
    <directoryBrowse enabled="false" />

  </system.webServer>

</configuration>
